PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.tz4iujd.mongodb.net/uniskill_db?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173

# --- Optional Email SMTP Configuration ---
# Option 1: Gmail Service (requires Google App Password from myaccount.google.com/apppasswords)
EMAIL_SERVICE=gmail
EMAIL_USER=your_university_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password

# Option 2: Custom University SMTP (e.g. mail.university.edu, Brevo, SendGrid, Mailgun)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@domain.com
# SMTP_PASS=your_smtp_password
# FROM_NAME="UniSkill Portal"
# FROM_EMAIL=noreply@uniskill.edu
